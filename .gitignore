.venv/
__pycache__/
*.pyc
build/
dist/

# OS/editor cruft — none of this is project-specific, just cheap insurance
# against someone (a future contributor, a different machine) committing it
# by accident.
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.egg-info/
.pytest_cache/
CLAUDE.md
HANDOFF.md
# External review notes, same status as HANDOFF.md: local working
# documents, not part of the public repo.
REVIEW-*.md
review_probes_*.py

# Spotify's official brand kit was supplied as a full download (print
# formats, every color/CMYK/PMS variant) — only the one SVG icons.py actually
# loads is tracked; the rest stays local-only so the repo doesn't carry ~4MB
# of unused .ai/.eps/.pdf files.
assets/*.ai
assets/*.eps
assets/*.pdf
assets/Primary_Logo_*.svg
!assets/Primary_Logo_Green_RGB.svg
assets/Spotify_Primary_Logo_RGB_*.png
